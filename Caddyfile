# خادم الموقع على ريلواي — موقع ثابت، فالخادم كل ما يلزمه.
# ريلواي تحقن رقم المنفذ في PORT، والافتراضي 80 عند التشغيل محلياً.
{
	admin off
	persist_config off
	auto_https off        # ريلواي تتولى TLS أمام الحاوية
}

:{$PORT:80} {
	root * /srv
	encode gzip zstd

	# النطاق المجرّد إلى www: وسم canonical في كل صفحة يشير إلى www،
	# فلا يصح أن يُقدَّم نفس المحتوى من عنوانين.
	@apex host tayibatfood.com
	redir @apex https://www.tayibatfood.com{uri} permanent

	# مسارات قديمة من هيكلة سابقة — تحويل دائم كي لا تضيع أي إشارة إليها
	redir /process            /services  permanent
	redir /en/process         /en/services  permanent
	redir /shipments          /quality  permanent
	redir /en/shipments       /en/quality  permanent
	redir /products/dried-fruit     /products/dried-fruits  permanent
	redir /en/products/dried-fruit  /en/products/dried-fruits  permanent
	redir /products/apples          /products/fresh-produce  permanent
	redir /en/products/apples       /en/products/fresh-produce  permanent

	# روابط نظيفة: /products/eggs يُخدَم من /products/eggs/index.html
	try_files {path} {path}/index.html
	file_server

	# روابط الأصول تحمل بصمة من محتواها (styles.css?v=3a4b49ea4d) يُولّدها البناء،
	# فأي تعديل يغيّر العنوان ويُجلب من جديد — ولذلك يصحّ تخزينها سنة بوسم immutable.
	# بغير البصمة كان المتصفح يتمسّك بأول نسخة نزلت عنده ويعرض الصفحة الجديدة
	# بتنسيق قديم. أما الصفحات و env.js فتُراجَع في كل زيارة.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path /assets/*
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}
